# Copy to .env to override. Every value below is the built-in default, so the
# stack runs without a .env file at all. These are local lab credentials only.

# Host-side ports (all bound to 127.0.0.1).
KAFKA_HOST_PORT=9092
SCHEMA_REGISTRY_HOST_PORT=8081
POSTGRES_HOST_PORT=5432

POSTGRES_USER=sync
POSTGRES_PASSWORD=sync
POSTGRES_DB=sync

# Container runtime. Auto-detected (docker compose, then podman compose) when unset.
# COMPOSE=podman compose
